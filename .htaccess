# FABIUS production rules for Apache/cPanel.

DirectoryIndex index.php index.html
Options -Indexes

# Use the branded standalone page for missing URLs.
ErrorDocument 404 /coming-soon/404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Internal application files may be included by PHP but never requested directly.
    RewriteRule ^(?:content|data|includes|templates)(?:/|$) - [F,L,NC]

    # Block hidden files, while allowing ACME certificate validation.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
</IfModule>

# Prevent direct access to common project, backup and environment files.
<FilesMatch "(?i)^(?:\.env(?:\..*)?|composer\.(?:json|lock)|package(?:-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|.*\.(?:bak|conf|dist|ini|log|pid|sh|sql|swp))$">
    Require all denied
</FilesMatch>

# Ensure modern asset formats receive the correct MIME type on older cPanel setups.
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>

# Compress text-based responses. Apache automatically skips formats already compressed.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# Browser expiry fallbacks for cPanel hosts with mod_expires enabled.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 5 minutes"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/json "access plus 5 minutes"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Static assets are safe to cache aggressively. Rename files when replacing them.
    <FilesMatch "(?i)\.(?:avif|gif|ico|jpe?g|png|svg|webp|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "(?i)\.(?:css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Page content can change; cache briefly and revalidate before reuse.
    <FilesMatch "(?i)\.(?:html?|php)$">
        Header set Cache-Control "private, max-age=300, must-revalidate"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
    Header always unset X-Powered-By
</IfModule>

# Enable these only after the production domain has a valid SSL certificate and
# the host is confirmed not to terminate HTTPS behind an unrecognised proxy.
